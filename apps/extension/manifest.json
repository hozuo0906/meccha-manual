{
  "manifest_version": 3,
  "name": "めっちゃマニュアル",
  "version": "0.1.9",
  "description": "いま開いているタブの操作を記録し、手順書をローカルで作成します。",
  "permissions": ["activeTab", "scripting", "storage", "windows", "sidePanel"],
  "host_permissions": ["https://meccha-manual-staging.meccha-iiyatsu.com/*"],
  "content_scripts": [
    {
      "matches": ["https://meccha-manual-staging.meccha-iiyatsu.com/onboarding/continue"],
      "js": ["content/onboarding-access-return.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": ["https://meccha-manual-staging.meccha-iiyatsu.com/*"]
  },
  "action": {
    "default_title": "操作を記録",
    "default_icon": {
      "128": "assets/meccha-manual-logo-mark.png"
    }
  },
  "icons": {
    "128": "assets/meccha-manual-logo-mark.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
