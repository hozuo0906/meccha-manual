{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meccha-iiyatsu-web",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./apps/brand-site/public",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
